{
    "name": "lhduc/laravel-gcp-logging",
    "description": "Reusable Google Cloud Logging integration for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lhduc\\LaravelGcpLogging\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "google/cloud-logging": "^1.32",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/framework": "^12",
        "monolog/monolog": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lhduc\\LaravelGcpLogging\\Providers\\GoogleLoggingServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Lhduc\\LaravelGcpLogging\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
